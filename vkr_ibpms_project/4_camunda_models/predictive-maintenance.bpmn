    <bpmn:sequenceFlow id="Flow_1t95po7" name="Перегрев" sourceRef="Gateway_1if5ism" targetRef="Activity_0wz8ri4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=anomalyType = "overheating"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03oernw" name="Износ" sourceRef="Gateway_1if5ism" targetRef="Activity_1c10srp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=anomalyType = "mechanical_wear"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0fm5417" name="Решено автоматически">
      <bpmn:incoming>Flow_0pu75ek</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0pu75ek" sourceRef="Activity_0wz8ri4" targetRef="Event_0fm5417" />
    <bpmn:exclusiveGateway id="Gateway_116c4cp" name="Требуется ремонт?">
