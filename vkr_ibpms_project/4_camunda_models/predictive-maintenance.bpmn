    <bpmn:serviceTask id="Activity_0wz8ri4" name="Снизить обороты шпинделя на 20%">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reduce-speed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1t95po7</bpmn:incoming>
      <bpmn:outgoing>Flow_0pu75ek</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_1c10srp" name="Осмотр станка техником">
